# ─────────────────────────────────────────────────────────────────────────────
# Вариант A: faster-whisper (CTranslate2 backend)
# 3–5x быстрее текущего PyTorch сервиса, без изменений API
# Деплой НА СЕРВЕРЕ через: npm run deploy:k8s --build-whisper
# НЕ СОБИРАТЬ ЛОКАЛЬНО — образ ~3.5GB
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.12-slim

WORKDIR /app

# Системные зависимости
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Python зависимости — faster-whisper вместо pytorch
RUN pip install --no-cache-dir \
        faster-whisper \
        uvicorn fastapi pydantic \
        python-multipart \
    && rm -rf /root/.cache/pip

# Директория для кэша модели (монтируется как PVC)
ENV HF_HOME=/hf-cache
RUN mkdir -p /hf-cache

# Копируем приложение
COPY app-faster-whisper.py ./app.py

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app /hf-cache
USER appuser

EXPOSE 8000
CMD ["python3", "/app/app.py"]

# ─────────────────────────────────────────────────────────────────────────────
# Вариант B: sherpa-onnx + SenseVoice + Silero VAD + CT-Transformer Punctuation
# 10-20x быстрее текущего, нативные C++ потоки, всё в Node.js
# НЕ СОБИРАТЬ ЛОКАЛЬНО — деплой через CI или remote build
# ─────────────────────────────────────────────────────────────────────────────

FROM node:20-bookworm-slim

WORKDIR /app

# ffmpeg для конвертации аудио/видео
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

# Копируем package.json и устанавливаем зависимости
# sherpa-onnx-node поставляется с prebuilt бинарями — не нужна компиляция
COPY package.json ./
RUN npm install --omit=dev

# Скрипт загрузки моделей (запускается при первом старте или через init-контейнер)
COPY download-models.sh ./
RUN chmod +x download-models.sh

# Копируем приложение
COPY app-sherpa.js ./

# Директория для моделей (монтируется как PVC)
RUN mkdir -p /models

ENV MODELS_DIR=/models
ENV PORT=8000
ENV NUM_THREADS=4

EXPOSE 8000

# При первом запуске скачиваем модели если их нет
CMD ["sh", "-c", "[ -f /models/sense_voice/model.onnx ] || ./download-models.sh && node app-sherpa.js"]

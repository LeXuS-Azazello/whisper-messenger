# Caddy reverse proxy for local development / fallback
# Usage: caddy run

voicemsg.net {
    reverse_proxy http://echo-frontend.debugging-testcrash-cloud.svc.cluster.local:80 {
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}

bridge.voicemsg.net {
    reverse_proxy http://mtproto-bridge-manager.debugging-testcrash-cloud.svc.cluster.local:3000 {
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
    }
}

asr.voicemsg.net {
    reverse_proxy http://qwen3-asr.debugging-testcrash-cloud.svc.cluster.local:11434 {
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote}
    }
}

{
  "name": "echo-messenger",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "npx tsx watch src/server.ts",
    "dev": "npx tsx src/server.ts",
    "test": "npx vitest run",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external --sourcemap",
    "build:ui": "echo 'UI assets are served directly from src/ui'",
    "deploy:k8s": "bash scripts/deploy.sh"
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^1.8.0",
    "@preact/signals": "^1.2.3",
    "adm-zip": "^0.5.10",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "hono": "^4.0.0",
    "ioredis": "^5.3.0",
    "mongoose": "^8.23.1",
    "preact": "^10.22.1",
    "preact-render-to-string": "^6.5.1",
    "preact-router": "^4.1.1",
    "prebuilt-tdlib": "^0.1008064.0",
    "qrcode": "^1.5.4",
    "tdl": "^7.4.0",
    "tdweb": "^1.8.0",
    "tsx": "^4.7.1",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^25.6.2",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.20.1",
    "supertest": "^7.0.0",
    "vitest": "^4.1.5"
  }
}

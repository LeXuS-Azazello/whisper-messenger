{
  "name": "voicemsg-frontend",
  "version": "1.0.185",
  "type": "module",
  "description": "Frontend server for Echo Messenger - Multi-Platform Voice Transcription",
  "main": "src/index.ts",
  "scripts": {
    "build": "npx tsc --noEmit",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:server": "tsx src/server.ts",
    "deploy:k8s": "kubectl apply -k kubernetes/base/ && kubectl apply -f kubernetes/frontend.yaml && kubectl rollout restart deployment echo-frontend -n debugging-testcrash-cloud"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.5",
    "hono": "^4.6.11",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "preact": "^10.29.0",
    "preact-render-to-string": "^6.6.7"
  },
  "overrides": {
    "undici": "^6.24.1"
  }
}

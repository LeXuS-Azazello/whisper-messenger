{
  "name": "echo-messenger",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "node --watch --conditions=worker src/index.ts",
    "dev": "npx tsx src/server.ts",
    "test": "npx vitest run",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external --sourcemap",
    "deploy:k8s": "bash scripts/deploy.sh"
  },
  "type": "module",
  "dependencies": {
    "@preact/signals": "^1.2.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "preact": "^10.22.1",
    "preact-render-to-string": "^6.5.1",
    "preact-router": "^4.1.1",
    "hono": "^4.0.0",
    "@hono/node-server": "^1.8.0",
    "ioredis": "^5.3.0",
    "tsx": "^4.7.1",
    "esbuild": "^0.20.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "supertest": "^7.0.0",
    "vitest": "^4.1.5"
  }
}

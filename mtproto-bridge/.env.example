# Telegram API credentials (get from my.telegram.org)
TG_API_ID=
TG_API_HASH=

# Leave CF_* empty to use local file session (recommended for Docker)
# CF_ACCOUNT_ID=
# CF_KV_NAMESPACE_ID=
# CF_API_TOKEN=

# Optional: Worker URL (legacy, not needed for local transcription)
# WORKER_URL=

# Auth secret for bridge endpoints
BRIDGE_SECRET=changeme

# Server port
PORT=3000